parameters:
	ignoreErrors:
		-
			message: "#^Parameter \\#2 \\$newvalue of function ini_set expects string, int given\\.$#"
			count: 2
			path: src/assembly.php

		-
			message: "#^Variable \\$dvd might not be defined\\.$#"
			count: 1
			path: src/assembly.php

		-
			message: "#^Variable \\$gpu might not be defined\\.$#"
			count: 1
			path: src/assembly.php

		-
			message: "#^Variable \\$hdd might not be defined\\.$#"
			count: 1
			path: src/assembly.php

		-
			message: "#^Variable \\$ssd2 might not be defined\\.$#"
			count: 1
			path: src/assembly.php

		-
			message: "#^Parameter \\#2 \\$value of function setcookie expects string, \\(float\\|int\\) given\\.$#"
			count: 1
			path: src/modules/configurator.php

		-
			message: "#^Parameter \\#2 \\$value of function setcookie expects string, int given\\.$#"
			count: 1
			path: src/modules/configurator.php

		-
			message: "#^Variable \\$mysql in isset\\(\\) always exists and is not nullable\\.$#"
			count: 1
			path: src/profile.php

