Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"

# 5-f-2: карта переехала с Google Maps на OpenStreetMap, внешних iframe
# больше нет.
#   img-src     - тайлы OSM. Зеркало tile.openstreetmap.de тоже нужно:
#                 замерено, основной хост отвечает 2,2 с, зеркало 0,5 с,
#                 и в admin-settings.js есть переключение на него при
#                 таймауте. Без него в CSP зеркало упало бы с ошибкой
#                 и переключение оказалось бы бессмысленным.
#                 data: нужен для вывода data:image из canvas, служебные
#                 картинки Leaflet приходят с того же 'self'.
#   connect-src - Nominatim: из браузера админа уходит запрос координат.
#                 Тайлы под connect-src не попадают, их грузит img-src.
#   script-src  - 'self': Leaflet лежит в репозитории, внешних скриптов нет.
#   frame-src   - 'none': встраивать iframe на сайте нечем и не нужно.
# Убраны maps.gstatic.com, *.googleapis.com, *.ggpht.com и frame-src на
# Google: после ухода с Google Maps они больше не нужны.
Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https://*.tile.openstreetmap.org https://tile.openstreetmap.de; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; connect-src 'self' https://nominatim.openstreetmap.org; frame-src 'none';"

# Стандартная страница Apache выглядит как чужой сервер и пугает посетителя.
# ErrorDocument ловит и отсутствующие .php, и битые ссылки на статику.
ErrorDocument 404 /404.php
