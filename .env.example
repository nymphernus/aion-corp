# Создание админа при первом docker compose up.
# УДАЛИТЕ ADMIN_PASSWORD после первого запуска и сделайте: docker compose up -d
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me_at_least_8_chars

# Настройки базы данных
MYSQL_ROOT_PASSWORD=root_password_change_me
MYSQL_USER=admin
MYSQL_PASSWORD=db_password_change_me

# Stage 10: демо-данные (тестовые компоненты каталога).
# 0 = чистая БД со схемой и настройками, 1 = залить компоненты из seed_components.php
SEED_DATA=0