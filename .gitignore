.env
.env.local
# /vendor/ - только корневой каталог Composer. Без ведущего слэша правило
# ловило бы любой каталог vendor на любом уровне и молча исключало
# src/assets/vendor с локальными Leaflet и html2canvas: на свежем клоне
# карта в админке не открылась бы. Проверено git check-ignore -v
/vendor/
node_modules/
*.log
backup_*.sql
tests/phpunit.phar
src/tests/.phpunit.result.cache

src/tests/.phpunit.result.cache

# 5-f-2: snimok karty delaet admin iz browsera - eto dannye vladelca, a ne
# ishodniki proekta. Katalog nuzhen, fР°Р№Р» vnutri - net
src/assets/uploads/*
!src/assets/uploads/.gitkeep

# ПРАВКА 4: иконку и логотип бренда делает админ - это данные владельца,
# а не исходники. Каталог нужен, файлы внутри нет: миграция создаст
# favicon.png заново из favicon_letter и favicon_bg, а логотип
# загружается с нуля. Как и с uploads, без этого правила git стал бы
# следить за чужими картинками.
src/assets/images/branding/*
!src/assets/images/branding/.gitkeep
# 3.7-g-5: рабочий документ, в репозитории не нужен
AGENT.md
